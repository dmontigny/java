 * @Description     : Write a Java code that create a float variable and cast
 *                      it into int by following the below instructions:
 *                        declare a float variable with the name measurement
 *                          and assign a value 4.75 to it
 *                        declare a int variable with the name recordedDepth
 *                          and assign a value to it by performing explicit
 *                          casting using the float variable measurement
 *                        print the value inside the variable recordedDepth
 *                          using the System.out.println() statement
 * ###########################################################################*/

/* ============================= include files ===============================*/


/* ================================ macros ===================================*/


/* ============================ global variables =============================*/


/* =============================== prototypes ================================*/


/* ===========================================================================*/

public class CLASS {
  public static void main(String[] args) {
    System.out.println("\nProgram starting\n");  

    float measurement = 4.75F;
    int recordedDepth = (int)measurement;

    System.out.println(recordedDepth);

    System.out.println("\nProgram ending\n");  
    System.exit(0);
  }
} // main


