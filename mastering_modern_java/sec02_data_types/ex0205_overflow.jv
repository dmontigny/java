public class CLASS {
  public static void main(String[] args) {
    System.out.println("\nProgram starting\n");  

    int overflowNum;

    overflowNum = Integer.MAX_VALUE + 1;
    System.out.println(overflowNum);

    System.out.println("\nProgram ending\n");  
    System.exit(0);
  }
} // main


