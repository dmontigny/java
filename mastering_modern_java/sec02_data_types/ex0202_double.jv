/*
 * Write a Java code that declares a double variable with the name piValue and
 *  assign a value 3.14 to it.
 * Once the assignment of the value is completed, print the value inside the
 *  variable using the System.out.println() statement.
 */

public class Exercise0 {
  public static void main(String[] args) {
    System.out.println("\nProgram starting\n");  

    double piValue = 3.14;

    System.out.println(piValue);

    System.out.println("\nProgram ending\n");  
    System.exit(0);
  }
} // main


